{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"],
      "@/auth/*": ["src/auth/*"],
      "@/SupportType/*": ["src/supportType/*"],
      "@/DepartmentType/*": ["src/departmentType/*"],
      "@/knowledgeBase/*": ["src/knowledgeBase/*"],
      "@/careFacility/*": ["src/careFacility/*"],
      "@/HumanAgent/*": ["src/humanAgent/*"],
      "@/availability/*": ["src/availability/*"],
      "@/parentCompany/*": ["src/parentCompany/*"],
      "@/dealer/*": ["src/dealer/*"],
      "@/sse/*": ["src/sse/*"],
      "@/site/*": ["src/site/*"],
      "@/folder/*": ["src/folder/*"],
      "@/document/*": ["src/document/*"],
      "@/links/*": ["src/links/*"],
      "@/FAQ/*": ["src/FAQ/*"],
      "@/text/*": ["src/text/*"],
      "@/common/*": ["src/common/*"],
      "@/types/*": ["src/types/*"],
      "@/app/*": ["src/app/*"],
      "@/schema/*": ["src/schema/*"],
      "@/hubspot/*": ["src/hubspot/*"],
      "@/webhooks/*": ["src/webhooks/*"],
      "@/callHistory/*": ["src/callHistory/*"],
      "@/callTranscript/*": ["src/callTranscript/*"],
      "@/supportEmail/*": ["src/supportEmail/*"],
      "@/emailReply/*": ["src/emailReply/*"],
      "@/helper/*": ["src/helper/*"],
      "@/config/*": ["src/config/*"],
      "@/secret/*": ["src/secret/*"],
      "@/src/*": ["src/*"]
    },
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false
  }
}